<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ButtonTopMenu" TargetType="Button">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Margin" Value="18,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource PSTextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Halo" Fill="#FFFBFBFB" Stroke="{DynamicResource PSIconFocusStrokeBrush}" StrokeThickness="3" Opacity="0" />
                        <Ellipse x:Name="Outer" Width="60" Height="60" Stroke="{DynamicResource PSIconFocusOuterBrush}" StrokeThickness="2" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        <TextBlock x:Name="Label" Text="{TemplateBinding Tag}" Margin="-60,68,-60,-40" TextAlignment="Center"
                                   VerticalAlignment="Top" FontFamily="{DynamicResource PSFont}" FontWeight="SemiBold"
                                   FontSize="{DynamicResource PSFontSizeIconLabel}" Foreground="{DynamicResource PSTextPrimaryBrush}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Foreground" Value="#FF101011" />
                            <Setter TargetName="Halo" Property="Opacity" Value="1" />
                            <Setter TargetName="Outer" Property="Opacity" Value="1" />
                            <Setter TargetName="Label" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.25" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
