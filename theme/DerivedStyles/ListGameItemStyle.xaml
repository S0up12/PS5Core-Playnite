<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="ListGameItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ControlTemplate.Resources>
                        <BackEase x:Key="Jump" EasingMode="EaseOut" Amplitude="0.12" />
                        <CubicEase x:Key="Out" EasingMode="EaseOut" />
                        <Storyboard x:Key="FocusIn">
                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX"
                                             To="1.15" Duration="0:0:0.3" EasingFunction="{StaticResource Jump}" />
                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY"
                                             To="1.15" Duration="0:0:0.3" EasingFunction="{StaticResource Jump}" />
                            <DoubleAnimation Storyboard.TargetName="Orbit" Storyboard.TargetProperty="Opacity"
                                             To="1" BeginTime="0:0:0.06" Duration="0:0:0.14" />
                        </Storyboard>
                        <Storyboard x:Key="OrbitSpin" RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="O0" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-234" Duration="0:0:2.2" />
                            <DoubleAnimation Storyboard.TargetName="O1" Storyboard.TargetProperty="StrokeDashOffset" From="4" To="-230" Duration="0:0:2.2" />
                            <DoubleAnimation Storyboard.TargetName="O2" Storyboard.TargetProperty="StrokeDashOffset" From="8" To="-226" Duration="0:0:2.2" />
                            <DoubleAnimation Storyboard.TargetName="O3" Storyboard.TargetProperty="StrokeDashOffset" From="12" To="-222" Duration="0:0:2.2" />
                            <DoubleAnimation Storyboard.TargetName="O4" Storyboard.TargetProperty="StrokeDashOffset" From="16" To="-218" Duration="0:0:2.2" />
                            <DoubleAnimation Storyboard.TargetName="O5" Storyboard.TargetProperty="StrokeDashOffset" From="20" To="-214" Duration="0:0:2.2" />
                            <DoubleAnimation Storyboard.TargetName="O6" Storyboard.TargetProperty="StrokeDashOffset" From="24" To="-210" Duration="0:0:2.2" />
                            <DoubleAnimation Storyboard.TargetName="O7" Storyboard.TargetProperty="StrokeDashOffset" From="28" To="-206" Duration="0:0:2.2" />
                            <DoubleAnimation Storyboard.TargetName="O8" Storyboard.TargetProperty="StrokeDashOffset" From="32" To="-202" Duration="0:0:2.2" />
                            <DoubleAnimation Storyboard.TargetName="O9" Storyboard.TargetProperty="StrokeDashOffset" From="36" To="-198" Duration="0:0:2.2" />
                            <DoubleAnimation Storyboard.TargetName="O10" Storyboard.TargetProperty="StrokeDashOffset" From="40" To="-194" Duration="0:0:2.2" />
                            <DoubleAnimation Storyboard.TargetName="O11" Storyboard.TargetProperty="StrokeDashOffset" From="44" To="-190" Duration="0:0:2.2" />
                            <DoubleAnimation Storyboard.TargetName="O12" Storyboard.TargetProperty="StrokeDashOffset" From="48" To="-186" Duration="0:0:2.2" />
                            <DoubleAnimation Storyboard.TargetName="O13" Storyboard.TargetProperty="StrokeDashOffset" From="52" To="-182" Duration="0:0:2.2" />
                        </Storyboard>
                        <Storyboard x:Key="FocusOut">
                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="0:0:0.25" EasingFunction="{StaticResource Out}" />
                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.25" EasingFunction="{StaticResource Out}" />
                            <DoubleAnimation Storyboard.TargetName="Orbit" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.08" />
                        </Storyboard>
                    <Storyboard x:Key="Intro0">
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.00" Duration="0:0:0.45" EasingFunction="{StaticResource Out}" />
                            <DoubleAnimation Storyboard.TargetName="TileShift" Storyboard.TargetProperty="X" From="110" To="0" BeginTime="0:0:0.00" Duration="0:0:0.6" EasingFunction="{StaticResource Out}" />
                        </Storyboard>
                        <Storyboard x:Key="Intro1">
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.05" Duration="0:0:0.45" EasingFunction="{StaticResource Out}" />
                            <DoubleAnimation Storyboard.TargetName="TileShift" Storyboard.TargetProperty="X" From="110" To="0" BeginTime="0:0:0.05" Duration="0:0:0.6" EasingFunction="{StaticResource Out}" />
                        </Storyboard>
                        <Storyboard x:Key="Intro2">
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.10" Duration="0:0:0.45" EasingFunction="{StaticResource Out}" />
                            <DoubleAnimation Storyboard.TargetName="TileShift" Storyboard.TargetProperty="X" From="110" To="0" BeginTime="0:0:0.10" Duration="0:0:0.6" EasingFunction="{StaticResource Out}" />
                        </Storyboard>
                        <Storyboard x:Key="Intro3">
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.15" Duration="0:0:0.45" EasingFunction="{StaticResource Out}" />
                            <DoubleAnimation Storyboard.TargetName="TileShift" Storyboard.TargetProperty="X" From="110" To="0" BeginTime="0:0:0.15" Duration="0:0:0.6" EasingFunction="{StaticResource Out}" />
                        </Storyboard>
                        <Storyboard x:Key="Intro4">
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.20" Duration="0:0:0.45" EasingFunction="{StaticResource Out}" />
                            <DoubleAnimation Storyboard.TargetName="TileShift" Storyboard.TargetProperty="X" From="110" To="0" BeginTime="0:0:0.20" Duration="0:0:0.6" EasingFunction="{StaticResource Out}" />
                        </Storyboard>
                        <Storyboard x:Key="Intro5">
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.25" Duration="0:0:0.45" EasingFunction="{StaticResource Out}" />
                            <DoubleAnimation Storyboard.TargetName="TileShift" Storyboard.TargetProperty="X" From="110" To="0" BeginTime="0:0:0.25" Duration="0:0:0.6" EasingFunction="{StaticResource Out}" />
                        </Storyboard>
                        <Storyboard x:Key="Intro6">
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.30" Duration="0:0:0.45" EasingFunction="{StaticResource Out}" />
                            <DoubleAnimation Storyboard.TargetName="TileShift" Storyboard.TargetProperty="X" From="110" To="0" BeginTime="0:0:0.30" Duration="0:0:0.6" EasingFunction="{StaticResource Out}" />
                        </Storyboard>
                        <Storyboard x:Key="Intro7">
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.35" Duration="0:0:0.45" EasingFunction="{StaticResource Out}" />
                            <DoubleAnimation Storyboard.TargetName="TileShift" Storyboard.TargetProperty="X" From="110" To="0" BeginTime="0:0:0.35" Duration="0:0:0.6" EasingFunction="{StaticResource Out}" />
                        </Storyboard>
                        <Storyboard x:Key="Intro8">
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.40" Duration="0:0:0.45" EasingFunction="{StaticResource Out}" />
                            <DoubleAnimation Storyboard.TargetName="TileShift" Storyboard.TargetProperty="X" From="110" To="0" BeginTime="0:0:0.40" Duration="0:0:0.6" EasingFunction="{StaticResource Out}" />
                        </Storyboard>
                        <Storyboard x:Key="Intro9">
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.45" Duration="0:0:0.45" EasingFunction="{StaticResource Out}" />
                            <DoubleAnimation Storyboard.TargetName="TileShift" Storyboard.TargetProperty="X" From="110" To="0" BeginTime="0:0:0.45" Duration="0:0:0.6" EasingFunction="{StaticResource Out}" />
                        </Storyboard>
                        <Storyboard x:Key="Intro10">
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.50" Duration="0:0:0.45" EasingFunction="{StaticResource Out}" />
                            <DoubleAnimation Storyboard.TargetName="TileShift" Storyboard.TargetProperty="X" From="110" To="0" BeginTime="0:0:0.50" Duration="0:0:0.6" EasingFunction="{StaticResource Out}" />
                        </Storyboard>
                        <Storyboard x:Key="Intro11">
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.55" Duration="0:0:0.45" EasingFunction="{StaticResource Out}" />
                            <DoubleAnimation Storyboard.TargetName="TileShift" Storyboard.TargetProperty="X" From="110" To="0" BeginTime="0:0:0.55" Duration="0:0:0.6" EasingFunction="{StaticResource Out}" />
                        </Storyboard>
                        <Storyboard x:Key="Intro12">
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.60" Duration="0:0:0.45" EasingFunction="{StaticResource Out}" />
                            <DoubleAnimation Storyboard.TargetName="TileShift" Storyboard.TargetProperty="X" From="110" To="0" BeginTime="0:0:0.60" Duration="0:0:0.6" EasingFunction="{StaticResource Out}" />
                        </Storyboard>
                        <Storyboard x:Key="Intro13">
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.65" Duration="0:0:0.45" EasingFunction="{StaticResource Out}" />
                            <DoubleAnimation Storyboard.TargetName="TileShift" Storyboard.TargetProperty="X" From="110" To="0" BeginTime="0:0:0.65" Duration="0:0:0.6" EasingFunction="{StaticResource Out}" />
                        </Storyboard>
                        <Storyboard x:Key="Intro14">
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.70" Duration="0:0:0.45" EasingFunction="{StaticResource Out}" />
                            <DoubleAnimation Storyboard.TargetName="TileShift" Storyboard.TargetProperty="X" From="110" To="0" BeginTime="0:0:0.70" Duration="0:0:0.6" EasingFunction="{StaticResource Out}" />
                        </Storyboard>
                        <Storyboard x:Key="Intro15">
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.75" Duration="0:0:0.45" EasingFunction="{StaticResource Out}" />
                            <DoubleAnimation Storyboard.TargetName="TileShift" Storyboard.TargetProperty="X" From="110" To="0" BeginTime="0:0:0.75" Duration="0:0:0.6" EasingFunction="{StaticResource Out}" />
                        </Storyboard>
                        </ControlTemplate.Resources>
                    <!-- fixed 106 tile inside whatever slot the panel gives; top-left anchored -->
                    <Grid x:Name="Tile" Margin="9,12,9,42" Opacity="0"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          RenderTransformOrigin="0.5,0"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="TileShift" X="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <ContentPresenter />
                        <Grid x:Name="Orbit" Margin="-2" Opacity="0" IsHitTestVisible="False">
                            <Rectangle x:Name="O0" RadiusX="18" RadiusY="18" Stroke="White" StrokeThickness="3" StrokeDashArray="4 230" Opacity="1.00" StrokeDashOffset="0" />
                            <Rectangle x:Name="O1" RadiusX="18" RadiusY="18" Stroke="White" StrokeThickness="3" StrokeDashArray="4 230" Opacity="0.93" StrokeDashOffset="4" />
                            <Rectangle x:Name="O2" RadiusX="18" RadiusY="18" Stroke="White" StrokeThickness="3" StrokeDashArray="4 230" Opacity="0.86" StrokeDashOffset="8" />
                            <Rectangle x:Name="O3" RadiusX="18" RadiusY="18" Stroke="White" StrokeThickness="3" StrokeDashArray="4 230" Opacity="0.79" StrokeDashOffset="12" />
                            <Rectangle x:Name="O4" RadiusX="18" RadiusY="18" Stroke="White" StrokeThickness="3" StrokeDashArray="4 230" Opacity="0.71" StrokeDashOffset="16" />
                            <Rectangle x:Name="O5" RadiusX="18" RadiusY="18" Stroke="White" StrokeThickness="3" StrokeDashArray="4 230" Opacity="0.64" StrokeDashOffset="20" />
                            <Rectangle x:Name="O6" RadiusX="18" RadiusY="18" Stroke="White" StrokeThickness="3" StrokeDashArray="4 230" Opacity="0.57" StrokeDashOffset="24" />
                            <Rectangle x:Name="O7" RadiusX="18" RadiusY="18" Stroke="White" StrokeThickness="3" StrokeDashArray="4 230" Opacity="0.50" StrokeDashOffset="28" />
                            <Rectangle x:Name="O8" RadiusX="18" RadiusY="18" Stroke="White" StrokeThickness="3" StrokeDashArray="4 230" Opacity="0.43" StrokeDashOffset="32" />
                            <Rectangle x:Name="O9" RadiusX="18" RadiusY="18" Stroke="White" StrokeThickness="3" StrokeDashArray="4 230" Opacity="0.36" StrokeDashOffset="36" />
                            <Rectangle x:Name="O10" RadiusX="18" RadiusY="18" Stroke="White" StrokeThickness="3" StrokeDashArray="4 230" Opacity="0.29" StrokeDashOffset="40" />
                            <Rectangle x:Name="O11" RadiusX="18" RadiusY="18" Stroke="White" StrokeThickness="3" StrokeDashArray="4 230" Opacity="0.21" StrokeDashOffset="44" />
                            <Rectangle x:Name="O12" RadiusX="18" RadiusY="18" Stroke="White" StrokeThickness="3" StrokeDashArray="4 230" Opacity="0.14" StrokeDashOffset="48" />
                            <Rectangle x:Name="O13" RadiusX="18" RadiusY="18" Stroke="White" StrokeThickness="3" StrokeDashArray="4 230" Opacity="0.07" StrokeDashOffset="52" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ListBox.AlternationIndex" Value="0"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Intro0}" /></Trigger.EnterActions></Trigger>
                        <Trigger Property="ListBox.AlternationIndex" Value="1"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Intro1}" /></Trigger.EnterActions></Trigger>
                        <Trigger Property="ListBox.AlternationIndex" Value="2"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Intro2}" /></Trigger.EnterActions></Trigger>
                        <Trigger Property="ListBox.AlternationIndex" Value="3"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Intro3}" /></Trigger.EnterActions></Trigger>
                        <Trigger Property="ListBox.AlternationIndex" Value="4"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Intro4}" /></Trigger.EnterActions></Trigger>
                        <Trigger Property="ListBox.AlternationIndex" Value="5"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Intro5}" /></Trigger.EnterActions></Trigger>
                        <Trigger Property="ListBox.AlternationIndex" Value="6"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Intro6}" /></Trigger.EnterActions></Trigger>
                        <Trigger Property="ListBox.AlternationIndex" Value="7"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Intro7}" /></Trigger.EnterActions></Trigger>
                        <Trigger Property="ListBox.AlternationIndex" Value="8"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Intro8}" /></Trigger.EnterActions></Trigger>
                        <Trigger Property="ListBox.AlternationIndex" Value="9"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Intro9}" /></Trigger.EnterActions></Trigger>
                        <Trigger Property="ListBox.AlternationIndex" Value="10"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Intro10}" /></Trigger.EnterActions></Trigger>
                        <Trigger Property="ListBox.AlternationIndex" Value="11"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Intro11}" /></Trigger.EnterActions></Trigger>
                        <Trigger Property="ListBox.AlternationIndex" Value="12"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Intro12}" /></Trigger.EnterActions></Trigger>
                        <Trigger Property="ListBox.AlternationIndex" Value="13"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Intro13}" /></Trigger.EnterActions></Trigger>
                        <Trigger Property="ListBox.AlternationIndex" Value="14"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Intro14}" /></Trigger.EnterActions></Trigger>
                        <Trigger Property="ListBox.AlternationIndex" Value="15"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Intro15}" /></Trigger.EnterActions></Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Panel.ZIndex" Value="90" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource FocusIn}" /><BeginStoryboard x:Name="OrbitBegin" Storyboard="{StaticResource OrbitSpin}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><StopStoryboard BeginStoryboardName="OrbitBegin" /><BeginStoryboard Storyboard="{StaticResource FocusOut}" /></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
