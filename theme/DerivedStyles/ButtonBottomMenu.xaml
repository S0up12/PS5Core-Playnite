                                    Margin="{TemplateBinding Padding}">
                            <Ellipse Width="8" Height="8" Margin="3,0" Fill="{TemplateBinding Foreground}" />
                            <Ellipse Width="8" Height="8" Margin="3,0" Fill="{TemplateBinding Foreground}" />
                            <Ellipse Width="8" Height="8" Margin="3,0" Fill="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <ContentControl x:Name="Hint" ContentTemplate="{TemplateBinding InputHint}" Height="30"
