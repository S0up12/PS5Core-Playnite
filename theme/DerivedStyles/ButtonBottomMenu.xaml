            </Setter.Value>
        </Setter>
    </Style>

    <!-- alias: old key still resolves -->
    <Style x:Key="ButtonBottomMenu" TargetType="ButtonEx" BasedOn="{StaticResource PSPillButton}" />
</ResourceDictionary>
