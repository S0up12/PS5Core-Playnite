<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Menu-row look: 28 px box, 4 px radius, 2 px stroke; checked fills the box. -->
    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource PSTextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Row" CornerRadius="{DynamicResource PSMenuRowCorner}"
                                BorderThickness="2" BorderBrush="Transparent"
                                Background="{TemplateBinding Background}">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="Box" Grid.Column="0" Width="28" Height="28" Margin="0,0,16,0"
                                        VerticalAlignment="Center" CornerRadius="4" BorderThickness="2"
                                        BorderBrush="{DynamicResource PSMenuFocusStrokeBrush}"
                                        Background="Transparent">
                                    <Viewbox x:Name="CheckIcon" Visibility="Collapsed" Margin="3">
                                        <TextBlock Text="b" FontFamily="Marlett"
                                                   Foreground="{DynamicResource PSTextInverseBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Viewbox>
                                </Border>
                                <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                           FontFamily="{DynamicResource PSFont}"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           Grid.Column="1" TextTrimming="WordEllipsis">
                                    <ContentPresenter RecognizesAccessKey="True" />
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckIcon" />
                            <Setter Property="Background" Value="{DynamicResource PSTextPrimaryBrush}" TargetName="Box" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PSTextPrimaryBrush}" TargetName="Box" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PSMenuFocusFillBrush}" TargetName="Row" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PSMenuFocusStrokeBrush}" TargetName="Row" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PSMenuFocusFillBrush}" TargetName="Row" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PSMenuFocusStrokeBrush}" TargetName="Row" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBoxEx" BasedOn="{StaticResource {x:Type CheckBox}}">
    </Style>
</ResourceDictionary>
