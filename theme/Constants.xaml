<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="GlyphColor">#FFCAA7D1</Color>
    <Color x:Key="GlyphLightColor">#FFFFFFFF</Color>
    <Color x:Key="SelectionLightColor">#1AFFFFFF</Color>
    <Color x:Key="OverlayColor">#B3000000</Color>

    <Color x:Key="ControlBackgroundColor">#FF2A2C33</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF1A1C22</Color>

    <Color x:Key="TextColor">#FFFBFBFB</Color>
    <Color x:Key="TextColorDark">#FFBFBFBF</Color>

    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="{DynamicResource GlyphLightColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{DynamicResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="{DynamicResource ControlBackgroundColorDark}" />
    <SolidColorBrush x:Key="SelectionLightBrush" Color="{DynamicResource SelectionLightColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{DynamicResource OverlayColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{DynamicResource ControlBackgroundColorDark}" />

    <sys:Double x:Key="FontSizeSmall">18</sys:Double>
    <sys:Double x:Key="FontSize">22</sys:Double>

    <sys:Double x:Key="FilterPanelWidth">480</sys:Double>

    <GridLength x:Key="ProgressWindowWidth">640</GridLength>

    <Style x:Key="TextBlockBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource PSFont}" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.15,0.1" Center="0.15,0.1" RadiusX="1.1" RadiusY="1.3">
        <GradientStop Color="#FF2B2420" Offset="0"/>
        <GradientStop Color="#FF1A1C22" Offset="0.45"/>
        <GradientStop Color="#FF0B0C10" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#66000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BottomBarBackgroundBrush" Color="Transparent"/>

    <SolidColorBrush x:Key="OverlayMenuBackgroundBrush" Color="#F21A1C22"/>

    <SolidColorBrush x:Key="SelectionBrush" Color="#FFCAA7D1"/>

    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.476,0.748" EndPoint="1.018,0.023">
        <GradientStop Color="#7D000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="WarningBrush" Color="#ff6b6b" />

    <!-- fonts -->
    <FontFamily x:Key="PSFont">Segoe UI</FontFamily>
    <FontFamily x:Key="PSFontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontWeight x:Key="PSWeightLight">Light</FontWeight>
    <FontWeight x:Key="PSWeightSemi">SemiBold</FontWeight>
    <!-- type scale (px) -->
    <sys:Double x:Key="PSFontSizeTab">36</sys:Double>
    <sys:Double x:Key="PSFontSizeClock">36</sys:Double>
    <sys:Double x:Key="PSFontSizeIconLabel">24</sys:Double>
    <sys:Double x:Key="PSFontSizePill">36</sys:Double>
    <sys:Double x:Key="PSFontSizeHubTitle">56</sys:Double>
    <sys:Double x:Key="PSFontSizeCardLabel">18</sys:Double>
    <sys:Double x:Key="PSFontSizeCardValue">30</sys:Double>
    <sys:Double x:Key="PSFontSizeCardCount">24</sys:Double>
    <sys:Double x:Key="PSFontSizeMenu">28</sys:Double>
    <sys:Double x:Key="PSFontSizeMenuHeader">44</sys:Double>
    <sys:Double x:Key="PSFontSizeSettingsRow">30</sys:Double>
    <sys:Double x:Key="PSFontSizeHint">20</sys:Double>
    <!-- colors -->
    <Color x:Key="PSTextPrimaryColor">#FFFBFBFB</Color>
    <Color x:Key="PSTextSecondaryColor">#FFBFBFBF</Color>
    <Color x:Key="PSTextInverseColor">#FF101011</Color>
    <Color x:Key="PSFocusColor">#FFCAA7D1</Color>
    <Color x:Key="PSTileBgColor">#B3000016</Color>
    <Color x:Key="PSPillFillColor">#24000000</Color>
    <Color x:Key="PSPillStrokeColor">#33FFFFFF</Color>   <!-- added for legibility -->
    <Color x:Key="PSCardFillColor">#6E000000</Color>
    <Color x:Key="PSOnlineColor">#FF1AFF84</Color>
    <Color x:Key="PSSeparatorColor">#1AFFFFFF</Color>
    <Color x:Key="PSPanelColor">#F21A1C22</Color>
    <Color x:Key="PSMenuFocusFillColor">#1AFFFFFF</Color>
    <Color x:Key="PSMenuFocusStrokeColor">#99FFFFFF</Color>
    <Color x:Key="PSAvatarRingColor">#33FFFFFF</Color>
    <Color x:Key="PSIconFocusOuterColor">#BF101011</Color>
    <!-- brushes -->
    <SolidColorBrush x:Key="PSTextPrimaryBrush" Color="#FFFBFBFB"/>
    <SolidColorBrush x:Key="PSTextSecondaryBrush" Color="#FFBFBFBF"/>
    <SolidColorBrush x:Key="PSTextInverseBrush" Color="#FF101011"/>
    <SolidColorBrush x:Key="PSFocusBrush" Color="#FFCAA7D1"/>
    <SolidColorBrush x:Key="PSSelectBrush" Color="#FF2F9BFF"/>
    <SolidColorBrush x:Key="PSTileBgBrush" Color="#B3000016"/>
    <SolidColorBrush x:Key="PSPillFillBrush" Color="#24000000"/>
    <SolidColorBrush x:Key="PSPillStrokeBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="PSCardFillBrush" Color="#6E000000"/>
    <SolidColorBrush x:Key="PSOnlineBrush" Color="#FF1AFF84"/>
    <SolidColorBrush x:Key="PSSeparatorBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="PSPanelBrush" Color="#F21A1C22"/>
    <SolidColorBrush x:Key="PSMenuFocusFillBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="PSMenuFocusStrokeBrush" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="PSAvatarRingBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="PSIconFocusOuterBrush" Color="#BF101011"/>
    <LinearGradientBrush x:Key="PSIconFocusStrokeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFE5D0D0" Offset="0"/><GradientStop Color="#00837777" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PSHubOverlayBrush" StartPoint="0.476,0.748" EndPoint="1.018,0.023">
        <GradientStop Color="#7D000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="PSSplashBrush" Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.8" RadiusY="0.9">
        <GradientStop Color="#FF2A1D17" Offset="0"/><GradientStop Color="#FF0A0808" Offset="1"/>
    </RadialGradientBrush>
    <!-- layout -->
    <sys:Double x:Key="PSTileSize">106</sys:Double>
    <sys:Double x:Key="PSTileFocusScale">1.708</sys:Double>   <!-- mirror only; storyboards hardcode -->
    <sys:Double x:Key="PSPillHeight">78</sys:Double>
    <sys:Double x:Key="PSPillWidth">371</sys:Double>
    <sys:Double x:Key="PSCircleWidth">84</sys:Double>
    <sys:Double x:Key="PSCardWidth">370</sys:Double>
    <sys:Double x:Key="PSCardHeight">145</sys:Double>
    <sys:Double x:Key="PSTopBarHeight">110</sys:Double>
    <sys:Double x:Key="PSRowHeight">250</sys:Double>   <!-- slot 106 + 75 growth + 19; tuned in R1 -->
    <sys:Double x:Key="PSMenuWidth">640</sys:Double>
    <sys:Double x:Key="PSSettingsWidth">1320</sys:Double>
    <Thickness x:Key="PSTabsMargin">91,33,0,0</Thickness>
    <Thickness x:Key="PSTopRightMargin">0,33,66,0</Thickness>
    <Thickness x:Key="PSRowMargin">181,131,0,0</Thickness>
    <Thickness x:Key="PSHubTitleMargin">231,0,0,319</Thickness>   <!-- box bottom at y=761 -->
    <Thickness x:Key="PSHubButtonsMargin">204,817,0,0</Thickness>
    <Thickness x:Key="PSStatsCardMargin">0,751,177,0</Thickness>
    <CornerRadius x:Key="PSTileCorner">16</CornerRadius>
    <CornerRadius x:Key="PSPillCorner">39</CornerRadius>
    <CornerRadius x:Key="PSPanelCorner">12</CornerRadius>
    <CornerRadius x:Key="PSMenuRowCorner">6</CornerRadius>
    <CornerRadius x:Key="PSInputCorner">4</CornerRadius>
</ResourceDictionary>
