<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="PSDetailsLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource PSFont}" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="FontSize" Value="{DynamicResource PSFontSizeCardLabel}" />
        <Setter Property="Foreground" Value="{DynamicResource PSTextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PSDetailsValue" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource PSFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource PSFontSizeCardValue}" />
        <Setter Property="Foreground" Value="{DynamicResource PSTextPrimaryBrush}" />
    </Style>

    <Style TargetType="{x:Type GameDetails}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameDetails}">
                    <Grid Background="{DynamicResource MainBackgourndBrush}"
                          x:Name="PART_ViewHost"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle">

                        <FadeImage HorizontalAlignment="Center" VerticalAlignment="Center"
                                   x:Name="PART_ImageBackground" />

                        <Rectangle Fill="{DynamicResource PSHubOverlayBrush}" IsHitTestVisible="False" />
                        <Rectangle IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#99000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- cover -->
                        <Border Width="172" Height="172" Margin="231,250,0,0"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Border.OpacityMask>
                                <VisualBrush Stretch="Fill">
                                    <VisualBrush.Visual>
                                        <Border Width="172" Height="172" CornerRadius="16" Background="Black" />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Border.OpacityMask>
                            <Image x:Name="PART_ImageCover" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="Fant" />
                        </Border>

                        <!-- stats row, between cover and title -->
                        <StackPanel Orientation="Horizontal" Margin="231,450,0,0" MaxWidth="1100"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PSDetailsLabel}"
                                           Text="{DynamicResource LOCTimePlayed}" />
                                <TextBlock Style="{StaticResource PSDetailsValue}"
                                           Text="{Binding Playtime, Converter={StaticResource PlayTimeToStringConverter}}" />
                            </StackPanel>
                            <StackPanel Margin="50,0,0,0">
                                <TextBlock Style="{StaticResource PSDetailsLabel}"
                                           Text="{DynamicResource LOCGameLastActivityTitle}" />
                                <TextBlock Style="{StaticResource PSDetailsValue}"
                                           Text="{Binding LastActivity, Converter={StaticResource DateTimeToLastPlayedConverter}}" />
                            </StackPanel>
                            <StackPanel Margin="50,0,0,0">
                                <TextBlock Style="{StaticResource PSDetailsLabel}"
                                           Text="{DynamicResource LOCGameReleaseDateTitle}" />
                                <TextBlock Style="{StaticResource PSDetailsValue}"
                                           Text="{Binding ReleaseDate}" />
                            </StackPanel>
                            <StackPanel Margin="50,0,0,0">
                                <TextBlock Style="{StaticResource PSDetailsLabel}"
                                           Text="{DynamicResource LOCGamePlatformTitle}" />
                                <TextBlock Style="{StaticResource PSDetailsValue}"
                                           Text="{Binding Platforms, Converter={StaticResource ListToStringConverter}}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="400" />
                            </StackPanel>
                        </StackPanel>

                        <!-- library icon + title, bottom-aligned like the main hub (box bottom y=761) -->
                        <StackPanel Margin="{DynamicResource PSHubTitleMargin}" MaxWidth="1100"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            <Image Source="{Binding LibraryPlugin.LibraryIcon}" Height="40" Width="40"
                                   HorizontalAlignment="Left" Margin="0,0,0,12"
                                   RenderOptions.BitmapScalingMode="Fant" />
                            <TextBlock Style="{StaticResource TextBlockBaseStyle}"
                                       Text="{Binding DisplayName}"
                                       FontFamily="{DynamicResource PSFont}" FontWeight="Light" FontSize="64"
                                       Foreground="{DynamicResource PSTextPrimaryBrush}"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="170" />
                        </StackPanel>

                        <!-- buttons: x204 y817 -->
                        <StackPanel Orientation="Horizontal" Margin="{DynamicResource PSHubButtonsMargin}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                            <ButtonEx x:Name="PART_ButtonContext"
                                      Style="{DynamicResource PSPillButton}" Focusable="True" />
                            <ButtonEx x:Name="PART_ButtonOptions"
                                      Content="{DynamicResource LOCGameOptions}"
                                      Style="{DynamicResource PSMoreButton}" Focusable="True" />
                        </StackPanel>

                        <!-- description card, right-anchored -->
                        <Border Margin="0,180,177,0" Width="900" Height="540" Padding="32"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                CornerRadius="12" Background="{DynamicResource PSCardFillBrush}">
                            <ScrollViewerEx x:Name="PART_ScrollHtmlDescription"
                                            CustomScrollAmount="42">
                                <HtmlTextView x:Name="PART_HtmlDescription"
                                              HtmlFontSize="20"
                                              HtmlForeground="{DynamicResource TextColor}"
                                              LinkForeground="{DynamicResource GlyphColor}"
                                              FocusVisualStyle="{x:Null}" />
                            </ScrollViewerEx>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
