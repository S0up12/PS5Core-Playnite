<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Main}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Main}">
                    <Grid x:Name="PART_MainHost"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid x:Name="PART_ViewHost" Background="{DynamicResource MainBackgourndBrush}">

                            <FadeImage x:Name="PART_ImageBackground"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!-- hub overlay + top bar scrim -->
                            <Rectangle Fill="{DynamicResource PSHubOverlayBrush}" IsHitTestVisible="False" />
                            <Rectangle Height="180" VerticalAlignment="Top"
                                       Fill="{DynamicResource TopBarBackgroundBrush}" IsHitTestVisible="False" />

                            <!-- TOP BAR: tabs -->
                            <FilterPresetSelector x:Name="PART_FilterPresetSelector"
                                                  Margin="{DynamicResource PSTabsMargin}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top" />

                            <!-- status chips under the tabs -->
                            <StackPanel Margin="91,92,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Orientation="Horizontal">
                                <StackPanel x:Name="PART_ElemSearchActive" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock FontSize="{DynamicResource PSFontSizeHint}"
                                               Foreground="{DynamicResource PSTextSecondaryBrush}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Text="{DynamicResource LOCGameListSearchResults}"/>
                                    <TextBlock FontSize="{DynamicResource PSFontSizeHint}" Margin="10,0,0,0"
                                               Foreground="{DynamicResource PSTextPrimaryBrush}"
                                               Style="{DynamicResource TextBlockBaseStyle}"
                                               Text="{Binding AppSettings.Fullscreen.FilterSettings.Name}"/>
                                </StackPanel>
                                <TextBlock x:Name="PART_ElemExtraFilterActive"
                                           FontSize="{DynamicResource PSFontSizeHint}" Margin="20,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PSTextSecondaryBrush}"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           Text="{DynamicResource LOCGameListExtraFiltered}"/>
                            </StackPanel>

                            <!-- TOP BAR: right cluster -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,26,66,0" Height="64">

                                <StackPanel x:Name="PART_ElemProgressIndicator" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="0,0,18,0">
                                    <TextBlock x:Name="PART_TextProgressTooltip"
                                               Margin="0,0,15,0" FontSize="{DynamicResource PSFontSizeHint}"
                                               VerticalAlignment="Center"
                                               Style="{DynamicResource TextBlockBaseStyle}"/>
                                    <ContentControl Style="{DynamicResource ProgressIndicator}" Focusable="False"
                                                    Height="38" Width="38" VerticalAlignment="Center" />
                                </StackPanel>

                                <ButtonEx x:Name="PART_ButtonProgramUpdate" VerticalAlignment="Center"
                                          Tag="Update"
                                          Style="{DynamicResource ButtonTopMenu}">
                                    <TextBlock Text="&#xE895;" FontFamily="{DynamicResource PSFontIcons}" FontSize="30"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </ButtonEx>

                                <ButtonEx x:Name="PART_ButtonNotifications" VerticalAlignment="Center"
                                          Tag="Notifications">
                                    <Button.Content>
                                        <Grid>
                                            <TextBlock Text="&#xEA8F;" FontFamily="{DynamicResource PSFontIcons}" FontSize="30"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Ellipse Width="12" Height="12" Fill="{DynamicResource PSFocusBrush}"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                                     Margin="0,-4,-4,0" />
                                        </Grid>
                                    </Button.Content>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ButtonTopMenu}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </ButtonEx>

                                <ButtonEx x:Name="PART_ButtonFilter" VerticalAlignment="Center"
                                          Tag="{DynamicResource LOCFilter}"
                                          Style="{DynamicResource ButtonTopMenu}">
                                    <TextBlock Text="&#xE71C;" FontFamily="{DynamicResource PSFontIcons}" FontSize="30"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </ButtonEx>

                                <ButtonEx x:Name="PART_ButtonSearch" VerticalAlignment="Center"
                                          Tag="{DynamicResource LOCSearchLabel}"
                                          Style="{DynamicResource ButtonTopMenu}">
                                    <Path Data="{DynamicResource PSGeoSearch}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="31" Height="31" Stretch="Uniform" />
                                </ButtonEx>

                                <ButtonEx x:Name="PART_ButtonMainMenu" VerticalAlignment="Center"
                                          Tag="Settings"
                                          Style="{DynamicResource ButtonTopMenu}">
                                    <Path Data="{DynamicResource PSGeoGear}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="34" Height="34" Stretch="Uniform" />
                                </ButtonEx>

                                <!-- avatar, decorative -->
                                <Grid Width="64" Height="64" Margin="18,0" IsHitTestVisible="False">
                                    <Image Source="{ThemeFile 'Images/ps5avatar.png'}" Width="36" Height="36" RenderOptions.BitmapScalingMode="Fant" />
                                    <Ellipse Width="14" Height="14" Fill="{DynamicResource PSOnlineBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,11,12" />
                                </Grid>

                                <ContentControl x:Name="PART_ElemBatteryStatus" Focusable="False" FontSize="30"
                                                VerticalAlignment="Center" Margin="10,0,6,0">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Critical">
                                                    <Setter Property="Content" Value="{DynamicResource BatteryStatusCritical}" />
                                                    <Setter Property="Foreground" Value="Red" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Low">
                                                    <Setter Property="Content" Value="{DynamicResource BatteryStatusLow}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Medium">
                                                    <Setter Property="Content" Value="{DynamicResource BatteryStatusMedium}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="High">
                                                    <Setter Property="Content" Value="{DynamicResource BatteryStatusHigh}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PowerStatus.IsCharging}" Value="True">
                                                    <Setter Property="Content" Value="{DynamicResource BatteryStatusCharging}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                                <TextBlock x:Name="PART_TextBatteryPercentage" Style="{DynamicResource TextBlockBaseStyle}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                           FontSize="{DynamicResource PSFontSizeIconLabel}" />

                                <TextBlock x:Name="PART_TextClock" Margin="40,0,0,0" VerticalAlignment="Center"
                                           FontSize="{DynamicResource PSFontSizeClock}" FontWeight="Light"
                                           FontFamily="{DynamicResource PSFont}"
                                           Foreground="{DynamicResource PSTextPrimaryBrush}" />
                            </StackPanel>

                            <!-- ROW + FILTER PANELS -->
                            <DockPanel Margin="0,110,0,0">
                                <ListBoxEx x:Name="PART_ListGameItems" AlternationCount="16" Margin="181,21,0,0"
                                           Height="{DynamicResource PSRowHeight}" VerticalAlignment="Top"
                                           Background="Transparent" BorderThickness="0" ClipToBounds="False"
                                           ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                           ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                           KeyboardNavigation.DirectionalNavigation="Once" />
                            </DockPanel>

                            <TextBlock FontSize="40"
                                       Text="{DynamicResource LOCNoGamesFound}"
                                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- HUB INFO (re-animates on every game change) -->
                            <Grid x:Name="HubInfo" Opacity="1">
                                <Grid.RenderTransform>
                                    <TranslateTransform Y="0" />
                                </Grid.RenderTransform>
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.25" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="16" To="0" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedGame}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!-- title in the logo box -->
                                <TextBlock Margin="{DynamicResource PSHubTitleMargin}" MaxWidth="900" MaxHeight="150"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                           Text="{Binding SelectedGame.DisplayName, NotifyOnTargetUpdated=True}"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           FontFamily="{DynamicResource PSFont}" FontWeight="Light"
                                           FontSize="{DynamicResource PSFontSizeHubTitle}"
                                           Foreground="{DynamicResource PSTextPrimaryBrush}" />

                                <!-- pills -->
                                <StackPanel Orientation="Horizontal" Margin="{DynamicResource PSHubButtonsMargin}"
                                            HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <ButtonEx x:Name="PART_ButtonInstall" Style="{DynamicResource PSPillButton}"
                                              Content="{DynamicResource LOCInstallGame}" />
                                    <ButtonEx x:Name="PART_ButtonPlay" Style="{DynamicResource PSPillButton}"
                                              Content="{DynamicResource LOCPlayGame}" />
                                    <ButtonEx x:Name="PART_ButtonGameOptions" Style="{DynamicResource PSMoreButton}" />
                                    <ButtonEx x:Name="PART_ButtonDetails" Style="{DynamicResource PSCircleButton}">
                                        <TextBlock Text="&#xE946;" FontFamily="{DynamicResource PSFontIcons}" FontSize="28" />
                                    </ButtonEx>
                                </StackPanel>

                                <!-- stats card, right-anchored -->
                                <Border Width="{DynamicResource PSCardWidth}" Height="{DynamicResource PSCardHeight}"
                                        Margin="{DynamicResource PSStatsCardMargin}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="{DynamicResource PSCardFillBrush}">
                                    <Grid Margin="26,10,20,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock FontSize="{DynamicResource PSFontSizeCardLabel}"
                                                       Foreground="{DynamicResource PSTextSecondaryBrush}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Text="{DynamicResource LOCTimePlayed}" />
                                            <TextBlock FontSize="{DynamicResource PSFontSizeCardValue}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Text="{Binding SelectedGame.Playtime, Converter={StaticResource PlayTimeToStringConverter}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1">
                                            <TextBlock FontSize="{DynamicResource PSFontSizeCardLabel}"
                                                       Foreground="{DynamicResource PSTextSecondaryBrush}"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Text="{DynamicResource LOCGameLastActivityTitle}" />
                                            <TextBlock FontSize="{DynamicResource PSFontSizeCardValue}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Text="{Binding SelectedGame.LastActivity, Converter={StaticResource DateTimeToLastPlayedConverter}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <TextBlock FontSize="{DynamicResource PSFontSizeCardCount}"
                                                       MaxWidth="150" TextTrimming="CharacterEllipsis"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Text="{Binding SelectedGame.Platforms, Converter={StaticResource ListToStringConverter}}" />
                                            <TextBlock FontSize="{DynamicResource PSFontSizeCardCount}" Margin="30,0,0,0"
                                                       MaxWidth="150" TextTrimming="CharacterEllipsis"
                                                       Style="{DynamicResource TextBlockBaseStyle}"
                                                       Text="{Binding SelectedGame.CompletionStatus.Name}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- filter panels: right-side overlay above hub info, like the menus -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,90,0,0">
                                <Filters x:Name="PART_ElemFilters"
                                         Focusable="False" />

                                <FiltersAdditional x:Name="PART_ElemFiltersAdditional"
                                                   Focusable="False" />

                                <ContentControl x:Name="PART_ContentFilterItems"
                                                Focusable="False" />

                            </StackPanel>
                        </Grid>

                        <GameDetails x:Name="PART_ElemGameDetails"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <GameStatus x:Name="PART_ElemGameStatus"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
