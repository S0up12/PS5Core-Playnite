<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pmrk="clr-namespace:Playnite.FullscreenApp.Markup;assembly=Playnite.FullscreenApp">
    
    <Style x:Key="MainMenuBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PSPanelBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Width" Value="640" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,24,24,24" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Effect">
            <Setter.Value><DropShadowEffect ShadowDepth="0" BlurRadius="40" Opacity="0.5" Color="Black" /></Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,24,-24,24" To="0,24,24,24" Duration="0:0:0.22">
                            <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></ThicknessAnimation.EasingFunction>
                        </ThicknessAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="MainMenuButton" BasedOn="{StaticResource {x:Type ButtonEx}}" TargetType="ButtonEx">
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="FontSize" Value="{DynamicResource PSFontSizeMenu}" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <DataTemplate x:Key="MainMenuHeaderTemplate">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,8,40,24">
            <Image Source="{pmrk:ThemeFile 'Images/applogo_clean.png'}" Height="48"
                   RenderOptions.BitmapScalingMode="Fant" />
            <TextBlock Text="Playnite" FontSize="{DynamicResource PSFontSizeMenuHeader}" Style="{DynamicResource TextBlockBaseStyle}"
                       Margin="20,0,0,0"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="MainMenuSettingsButtonTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xef3a;" FontFamily="{DynamicResource FontIcoFont}" FontSize="24"
                       VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="{DynamicResource LOCSettingsLabel}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

